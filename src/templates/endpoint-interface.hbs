{{!--
  endpoint-interface.hbs — rendered once per TypeSpec interface as a C#
  `public interface` that declares every operation as a method.

  Operations whose response contains a model also get a generic overload so the
  caller can ask for a derived type:

    Task<Widget> ReadAsync(string id, ...);
    Task<TResult> ReadAsync<TResult>(string id, ...) where TResult : Widget;

  Override via tspconfig.yaml:
    options:
      "@massivescale/tsp-flurl-client":
        templates:
          endpoint-interface: "./templates/endpoint-interface.hbs"

  ── Template variables ──────────────────────────────────────────────────────

  {{interfaceName}} — C# interface name, e.g. "IWidgets"

  {{access}}        — C# access modifier: "public" or "internal"

  {{doc}}           — optional XML <summary> text (pre-escaped; may be falsy).

  {{methodsBlock}}  — pre-rendered string containing all method declarations,
                      each indented with 4 spaces and separated by blank lines.
                      Each method block contains:
                        - Optional doc comment: /// <summary>...</summary>
                        - Method signature:     Task<T> MethodAsync(params);
                        - A generic overload when the response has a model

  ── Built-in helpers ────────────────────────────────────────────────────────

  {{indent <text>}}  — prefixes every non-empty line of <text> with 4 spaces
  {{eq a b}}         — strict equality

--}}
/// <summary>
{{#if doc}}/// {{docLines doc "/// "}}
{{/if}}/// </summary>
{{access}} interface {{interfaceName}}
{
{{{methodsBlock}}}
}
