{{!--
  extensions.hbs — generates two top-level declarations in one file:
    1. A concrete `{clientClassName}` class that starts every request: one method
       per endpoint group and set of path parameters (e.g. `client.Pets()` and
       `client.Pets(id)`), each returning a new request builder, plus the Flurl
       client it was built on and `Create` factories for use without DI.
    2. A static `{className}` extension class that registers the client with
       ASP.NET Core's DI container.

  Override via tspconfig.yaml:
    options:
      "@massivescale/tsp-flurl-client":
        templates:
          extensions: "./templates/extensions.hbs"

  Template variables:

  {{clientClassName}} — name of the client class, e.g. "ApiClient"

  {{className}}       — name of the static extensions class, e.g. "ApiClientExtensions"

  {{methodName}}      — name of the public registration method, e.g. "AddApiClient"

  {{httpClientName}}  — name of the named HttpClient the registration creates,
                        unique per namespace and client

  {{builders}}        — array of request builder entries, one per client method. Each has:
    .groupName        —   the endpoint group (the TypeSpec interface), e.g. "Pets"
    .methodName       —   method name on the client, e.g. "Pets"
    .className        —   the builder it returns, e.g. "PetsItemRequestBuilder"
    .access           —   "public" or "internal"; the method's access modifier
    .params           —   the path parameters it takes, in order. Each has:
      .type           —     C# type, e.g. "string"
      .param          —     parameter name as written in C#, e.g. "id" or "@await"
      .docParam       —     the same name in XML documentation, never escaped
      .doc            —     the parameter's documentation (pre-escaped)

  Usage example:

  builder.Services.AddApiClient(
      c => c.BaseAddress = new Uri("https://api.example.com"),
      configureModels: m => m.Map<Pet, MyPet>());

  // Inject and call:
  public class MyService(ApiClient api)
  {
      public Task<MyPet> GetAsync(string id, CancellationToken ct) =>
          api.Pets(id).ReadAsync<MyPet>(cancellationToken: ct);
  }

  Built-in helpers:

  {{indent <text>}}  — prefixes every non-empty line of <text> with 4 spaces

--}}
/// <summary>
/// Unified client providing access to all API endpoints.
/// </summary>
/// <remarks>
/// Inject this class directly and start each call from the method named after its endpoint group,
/// e.g. <c>client.Pets().ListAsync(ct)</c> or <c>client.Pets(id).ReadAsync(ct)</c>. The underlying
/// <see cref="IFlurlClient"/> is exposed as <see cref="FlurlClient"/> for requests the generated methods
/// do not cover.
/// </remarks>
public class {{declaredName clientClassName}}
{
    /// <summary>
    /// Gets the Flurl client every request is sent through. It is already configured with the serializer
    /// that applies this client's <see cref="ModelMap"/>, so reading a model through it (for example
    /// <c>FlurlClient.Request("api/pets").GetJsonAsync&lt;Pet&gt;()</c>) yields the same custom types as
    /// the generated methods.
    /// </summary>
    public IFlurlClient FlurlClient { get; }

    /// <summary>
    /// Initializes a new instance of <see cref="{{clientClassName}}"/>.
    /// </summary>
    /// <param name="flurlClient">
    /// The Flurl client requests are sent through, already configured for this API, as <c>Create</c> does.
    /// </param>
    public {{clientClassName}}(IFlurlClient flurlClient)
    {
        FlurlClient = flurlClient ?? throw new ArgumentNullException(nameof(flurlClient));
    }

{{#each builders}}    /// <summary>
    /// Starts a request to the <c>{{groupName}}</c> endpoint group.
    /// </summary>
{{#each params}}    /// <param name="{{docParam}}">{{doc}}</param>
{{/each}}    /// <returns>A new builder; what is added to it applies only to the requests it sends.</returns>
    {{access}} {{className}} {{methodName}}({{#each params}}{{#unless @first}}, {{/unless}}{{type}} {{param}}{{/each}}) =>
        new {{className}}(this.FlurlClient{{#each params}}, {{param}}{{/each}});

{{/each}}
    /// <summary>
    /// Creates a client on top of an existing Flurl client, for use without dependency injection.
    /// The Flurl client's JSON serializer is replaced with the one this API needs.
    /// </summary>
    /// <param name="flurlClient">The Flurl client to send requests through; set its base URL first.</param>
    /// <param name="models">Optional custom models to substitute for the generated ones.</param>
    public static {{clientClassName}} Create(IFlurlClient flurlClient, ModelMap? models = null)
    {
        ClientRuntime.Configure(flurlClient, models);
        return new {{clientClassName}}(flurlClient);
    }

    /// <summary>
    /// Creates a client that talks to <paramref name="baseUrl"/>, for use without dependency injection.
    /// </summary>
    /// <param name="baseUrl">The API base URL, e.g. <c>https://api.example.com</c>.</param>
    /// <param name="configureModels">Optional callback that registers custom models.</param>
    public static {{clientClassName}} Create(string baseUrl, Action<ModelMap>? configureModels = null)
    {
        var models = new ModelMap();
        configureModels?.Invoke(models);
        return Create(new FlurlClient(baseUrl), models);
    }
}

/// <summary>
/// Extension methods to register the <see cref="{{clientClassName}}"/> with the DI container.
/// </summary>
public static class {{className}}
{
    private const string HttpClientName = "{{httpClientName}}";

    /// <summary>
    /// Registers the <see cref="{{clientClassName}}"/> with the DI container.
    /// </summary>
    /// <param name="services">The service collection.</param>
    /// <param name="configureHttpClient">Configures the underlying <see cref="HttpClient"/> (e.g. set <c>BaseAddress</c>).</param>
    /// <param name="configureBuilder">
    /// Optional. Receives the <see cref="IHttpClientBuilder"/> for the client and returns it, allowing
    /// additional configuration such as adding delegating handlers or resilience policies.
    /// </param>
    /// <param name="configureModels">
    /// Optional. Registers custom models, e.g. <c>m =&gt; m.Map&lt;Widget, MyWidget&gt;()</c>, so every
    /// <c>Widget</c> the client reads is deserialized as a <c>MyWidget</c>.
    /// </param>
    /// <param name="configureFlurlClient">
    /// Optional. Configures each Flurl client the registration creates, after its serializer is set, e.g.
    /// <c>f =&gt; f.BeforeCall(call =&gt; ...).AfterCall(call =&gt; ...)</c> to attach Flurl's event handlers
    /// or settings to every call. The client is transient, so this runs each time one is resolved.
    /// </param>
    public static IServiceCollection {{methodName}}(
        this IServiceCollection services,
        Action<HttpClient> configureHttpClient,
        Func<IHttpClientBuilder, IHttpClientBuilder>? configureBuilder = null,
        Action<ModelMap>? configureModels = null,
        Action<IFlurlClient>? configureFlurlClient = null)
    {
        if (services is null) throw new ArgumentNullException(nameof(services));
        if (configureHttpClient is null) throw new ArgumentNullException(nameof(configureHttpClient));

        // The map is captured here rather than registered by type: ModelMap is one type
        // shared by every API version in this project, so a container registration would
        // let one version's map replace another's.
        var models = new ModelMap();
        configureModels?.Invoke(models);

        // Flurl follows redirects itself, as its own client factory arranges, so the handler must not.
        var builder = services.AddHttpClient(HttpClientName, configureHttpClient)
            .ConfigurePrimaryHttpMessageHandler(() => new HttpClientHandler { AllowAutoRedirect = false });
        configureBuilder?.Invoke(builder);

        services.AddTransient<{{clientClassName}}>(sp => new {{clientClassName}}(CreateFlurlClient(sp, models, configureFlurlClient)));
        return services;
    }

    /// <summary>
    /// Creates a Flurl client around an <see cref="HttpClient"/> from <see cref="IHttpClientFactory"/>.
    /// </summary>
    /// <remarks>
    /// Nothing here needs to be disposed. The factory owns and pools the message handler, and
    /// gives out an <see cref="HttpClient"/> that does not dispose it, so disposing the client
    /// (which is all <see cref="FlurlClient.Dispose"/> does) releases nothing. That is why the
    /// Flurl client is not registered with the container, which would otherwise keep every
    /// transient instance alive until the container itself is disposed.
    /// </remarks>
    private static IFlurlClient CreateFlurlClient(
        IServiceProvider services,
        ModelMap models,
        Action<IFlurlClient>? configureFlurlClient)
    {
        var httpClient = services.GetRequiredService<IHttpClientFactory>().CreateClient(HttpClientName);
        var flurlClient = ClientRuntime.Configure(new FlurlClient(httpClient), models);
        configureFlurlClient?.Invoke(flurlClient);
        return flurlClient;
    }
}
